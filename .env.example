# Anthropic is the approved external extraction provider. Keep this server-side.
CONFERIA_FIELD_ENCRYPTION_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional Azure OpenAI provider. Keep these server-side; never expose the key in NEXT_PUBLIC_*.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional additional HTTPS provider hosts for approved private gateways.
CONFERIA_PROVIDER_ALLOWED_HOSTS=
TEXT_EXTRACTION_PROVIDER=HAIKU
VISION_EXTRACTION_PROVIDER=HAIKU

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CONFERIA_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
CRON_SECRET=
CONFERIA_ENV=
# Must remain false or unset in production. Local development only may opt out.
CONFERIA_AUTH_DISABLED=
